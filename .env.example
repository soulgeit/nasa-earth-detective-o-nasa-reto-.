# Copia este archivo a .env y rellena. NUNCA subas .env a git ni pegues valores en el chat o en reportes.

# Datos
DATA_CACHE_DIR=data/cache
ALLOW_FIXTURES=0

# IA: full (modelos) | extractive (sin modelo de lenguaje) | off
AI_MODE=extractive
LLM_BASE_URL=http://localhost:11434/v1
PLANNER_MODEL=etd-planner
EXPLAIN_MODEL=
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=

# Opcional: token de NASA Earthdata (https://urs.earthdata.nasa.gov) para fuentes de nivel 2
EARTHDATA_TOKEN=

# Modelo de lenguaje ALOJADO (opcional, RONDA_7). Sin LLM_API_KEY nada de esto se usa.
# Cualquier API compatible con OpenAI (/chat/completions). La clave va SOLO aqui o en las variables de
# Railway; nunca en el repo ni en el chat. Ver docs/RONDA_7.md §12.
# AI_MODE=full
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# PLANNER_MODEL=<modelo pequeno del proveedor>
# EXPLAIN_MODEL=<el mismo>
# LLM_DAILY_CALL_CAP=1500   # por defecto 2000 llamadas/dia cuando hay clave
